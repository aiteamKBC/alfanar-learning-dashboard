# Copy to .env and adjust. Never commit .env or credential files.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true behind HTTPS in production
DJANGO_SECURE_COOKIES=false
# Set true only when running behind nginx that sets X-Forwarded-Proto
DJANGO_BEHIND_PROXY=false

# --- Database (leave empty for local SQLite) ---
# DATABASE_URL=postgres://alfanar:password@localhost:5432/alfanar_dashboard
DATABASE_URL=

# --- Excel source (read-only) ---
ALFANAR_EXCEL_PATH=data/Alfanar Endpoint.xlsx

# Four authoritative attendance workbooks; outside the web root in production.
ATTENDANCE_DIRECTORY=data

# --- Google Sheets read-only sync (optional) ---
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# Service-account JSON key (Viewer access on the spreadsheet). Relative paths resolve from
# the project root; secrets/ is git-ignored. In production use /etc/alfanar-dashboard/google-sa.json.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
SYNC_INTERVAL_SECONDS=300

# --- Microsoft Graph timing (optional; backend only, application credentials) ---
# Requires admin-consented OnlineMeetingArtifact.Read.All and an application access
# policy for the verified organisers. Never put credentials in frontend variables.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SCOPE=https://graph.microsoft.com/.default
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# --- Dashboard owner account (read ONLY by `manage.py provision_owner`, from this file) ---
# Never loaded into the server environment or exposed to the frontend.
# username=your-dashboard-username
# password=choose-a-strong-password
